# Future activation example. Keep disabled until relay authentication,
# installation binding, and end-to-end acceptance are complete.
[mcp_servers.kivra_memory_relay]
url = "https://memory-relay.example/mcp"
bearer_token_env_var = "KIVRA_MEMORY_RELAY_TOKEN"
enabled = false
required = true
startup_timeout_sec = 10
tool_timeout_sec = 60
default_tools_approval_mode = "writes"
enabled_tools = [
  "memory_context_pack",
  "memory_search",
  "memory_get",
  "memory_timeline",
  "memory_conflicts",
  "memory_lineage",
  "memory_selection_history",
  "memory_selection_decisions",
  "memory_ingress_status",
  "memory_transport_status",
  "memory_nominate",
]
