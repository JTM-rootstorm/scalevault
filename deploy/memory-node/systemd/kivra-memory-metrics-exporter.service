[Unit]
Description=ScaleVault bounded local metrics exporter
After=network.target postgresql@17-main.service kivra-memory-operational-metrics.service
Requires=postgresql@17-main.service
Wants=kivra-memory-operational-metrics.timer
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memory-metrics
Group=memory-metrics
WorkingDirectory=/opt/kivra-memory/app
LoadCredential=database-url:/etc/kivra-memory/credentials/metrics-database-url
LoadCredential=tenant-id:/etc/kivra-memory/metrics-tenant-id
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
ExecStart=/opt/kivra-memory/app/.venv/bin/kivra-memory-metrics-exporter
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
KeyringMode=private
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
TasksMax=8
MemoryMax=192M
CPUQuota=50%
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:9098
CapabilityBoundingSet=
ReadOnlyPaths=-/run/kivra-memory-metrics/status.json

[Install]
WantedBy=multi-user.target
