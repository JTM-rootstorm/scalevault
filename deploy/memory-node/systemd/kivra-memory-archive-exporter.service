[Unit]
Description=ScaleVault signed Forgejo archive exporter
After=network-online.target postgresql@17-main.service
Wants=network-online.target
Requires=postgresql@17-main.service
RequiresMountsFor=/mnt/memory
ConditionPathIsMountPoint=/mnt/memory
ConditionPathIsDirectory=/mnt/memory/kivra-memory/archive
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memory-exporter
Group=kivra-memory
WorkingDirectory=/opt/kivra-memory/app
Environment=KIVRA_MEMORY_ENVIRONMENT=production
Environment=HOME=/nonexistent
EnvironmentFile=/etc/kivra-memory/memory-archive-exporter.env
LoadCredential=database-url:/etc/kivra-memory/memory-archive-exporter-database-url
LoadCredential=archive-signing-key:/etc/kivra-memory/archive-signing-key
LoadCredential=archive-deploy-key:/etc/kivra-memory/archive-deploy-key
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
ExecStartPre=/usr/bin/test -d /mnt/memory/kivra-memory/archive/.git
ExecStart=/opt/kivra-memory/app/.venv/bin/kivra-memory-archive-exporter
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
KeyringMode=private
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadOnlyPaths=/etc/kivra-memory/archive-allowed-signers /etc/kivra-memory/archive-known-hosts
ReadWritePaths=/mnt/memory/kivra-memory/archive

[Install]
WantedBy=multi-user.target
