[Unit]
Description=ScaleVault outbound OpenAI Secure MCP Tunnel
After=network-online.target kivra-memory-api.service
Wants=network-online.target
Requires=kivra-memory-api.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memory-tunnel
Group=memory-tunnel
EnvironmentFile=/etc/kivra-memory/tunnel.env
LoadCredential=control-plane-api-key:/etc/kivra-memory/tunnel-api-key
LoadCredential=chatgpt-mcp-authorization:/etc/kivra-memory/chatgpt-mcp-authorization
UnsetEnvironment=OPENAI_API_KEY CONTROL_PLANE_API_KEY CONTROL_PLANE_BASE_URL CONTROL_PLANE_CLIENT_CERT CONTROL_PLANE_CLIENT_KEY CONTROL_PLANE_EXTRA_HEADERS CONTROL_PLANE_HTTP_PROXY CONTROL_PLANE_ORGANIZATION_ID CONTROL_PLANE_URL_PATH
UnsetEnvironment=TUNNEL_CLIENT_CONFIG TUNNEL_CLIENT_PROFILE TUNNEL_CLIENT_PROFILE_FILE TUNNEL_CLIENT_PROFILE_DIR TUNNEL_CLIENT_HTTP_PROXY
UnsetEnvironment=MCP_SERVER_URL MCP_COMMAND MCP_EXTRA_HEADERS MCP_DISCOVERY_EXTRA_HEADERS MCP_CLIENT_CERT MCP_CLIENT_KEY MCP_HTTP_PROXY
UnsetEnvironment=ALLOW_REMOTE_UI OPEN_WEB_UI LOG_HTTP_RAW_UNSAFE LOG_FILE
UnsetEnvironment=HARPOON_TARGETS HARPOON_ADDITIONAL_TRANSPORTS HARPOON_ALLOW_PLAINTEXT_HTTP HARPOON_CAPTURE_PAYLOADS HARPOON_HTTP_PROXY
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
ExecStartPre=/usr/local/libexec/kivra-memory-tunnel-preflight /usr/local/bin/tunnel-client %d/control-plane-api-key %d/chatgpt-mcp-authorization
ExecStartPre=/usr/bin/curl --fail --silent --show-error --retry 20 --retry-delay 1 --retry-connrefused http://127.0.0.1:8080/readyz
ExecStartPre=/usr/local/libexec/kivra-memory-tunnel-mcp-probe /usr/bin/curl %d/chatgpt-mcp-authorization http://127.0.0.1:8080/chatgpt/mcp
ExecStart=/usr/local/bin/tunnel-client run --control-plane.tunnel-id=${CONTROL_PLANE_TUNNEL_ID} --control-plane.api-key=file:%d/control-plane-api-key --mcp.server-url=url=http://127.0.0.1:8080/chatgpt/mcp,channel=main --mcp.extra-headers="Authorization: file:%d/chatgpt-mcp-authorization" --mcp.discovery-extra-headers="Authorization: file:%d/chatgpt-mcp-authorization" --mcp.max-concurrent-requests=4 --control-plane.max-inflight=4 --health.listen-addr=127.0.0.1:8081 --log.level=info --log.format=json --log.file=stdout
Restart=always
RestartSec=10s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
