[Unit]
Description=ScaleVault least-privilege sealed-key destruction broker
After=local-fs.target
ConditionPathIsDirectory=/var/lib/kivra-memory-sealed/purge-requests
ConditionPathIsDirectory=/var/lib/kivra-memory-sealed/destruction-ledger
ConditionPathIsDirectory=/var/lib/kivra-memory-destruction-anchor
ConditionFileNotEmpty=/etc/kivra-memory/destruction-ledger-anchor
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=memory-destruction
Group=memory-destruction
SupplementaryGroups=kivra-sealed kivra-destruction-ledger kivra-destruction-request
WorkingDirectory=/opt/kivra-memory/app
LoadCredential=destruction-ledger-anchor:/etc/kivra-memory/destruction-ledger-anchor
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
ExecStart=/opt/kivra-memory/app/.venv/bin/kivra-memory-destruction-broker
TimeoutStartSec=60s
TimeoutStopSec=30s
UMask=0007
LimitCORE=0
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
KeyringMode=private
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kivra-memory-sealed/purge-requests
ReadWritePaths=/var/lib/kivra-memory-sealed/keys/control
ReadWritePaths=/var/lib/kivra-memory-sealed/keys/material
ReadWritePaths=/var/lib/kivra-memory-sealed/destruction-ledger
ReadWritePaths=/var/lib/kivra-memory-destruction-anchor
