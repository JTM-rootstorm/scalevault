[Unit]
Description=ScaleVault protected operator report %i
Documentation=file:/usr/share/doc/scalevault/operations.md
After=postgresql@17-main.service
Requires=postgresql@17-main.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/
Environment=HOME=/nonexistent
LoadCredential=database-url:/etc/kivra-memory/credentials/operator-report-database-url
LoadCredential=tenant-id:/etc/kivra-memory/operator-report-scopes/%i
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
ExecStart=/opt/kivra-memory/app/.venv/bin/kivra-memory-operator-report-run --report-id %i
StateDirectory=kivra-memory/operator-reports
StateDirectoryMode=0700
TimeoutStopSec=30s
LimitCORE=0
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

# Reports contain bounded identity metadata. They are never streamed to the journal.
StandardOutput=null
StandardError=journal
