[Unit]
Description=ScaleVault fixed-schema operational metrics publisher
After=postgresql@17-main.service
RequiresMountsFor=/mnt/memory /mnt/memory-backup
ConditionPathIsMountPoint=/mnt/memory-backup
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=root
Group=memory-metrics
ExecStart=/usr/local/libexec/kivra-memory-operational-metrics-publish
RuntimeDirectory=kivra-memory-metrics
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027
TimeoutStartSec=30s
TimeoutStopSec=30s
LimitCORE=0
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
KeyringMode=private
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
ReadOnlyPaths=/mnt/memory-backup/kivra-memory-postgres/status/latest-base.json
ReadOnlyPaths=-/mnt/memory-backup/kivra-memory-postgres/status/operational-counters-base-backup.json
ReadOnlyPaths=-/mnt/memory-backup/kivra-memory-postgres/status/operational-counters-backup-verification.json
ReadOnlyPaths=-/mnt/memory-backup/kivra-memory-postgres/status/operational-counters-wal-archive.json
ReadOnlyPaths=/mnt/memory/kivra-memory/postgresql/17/main/pg_wal/archive_status
ReadOnlyPaths=/var/lib/prometheus
ReadWritePaths=/run/kivra-memory-metrics
