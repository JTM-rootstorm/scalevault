# Policy template only. Adapt it through the installed Nginx Proxy Manager
# version and inspect the generated configuration before activation.
# The Proxy Host must use the exact TLS hostname, have Force SSL redirects
# disabled, and have an NPM Access List that rejects non-LAN/VPN clients before
# upstream selection. A shared edge listener is allowed only with that ordering.

location = /mcp {
    allow REPLACE_WITH_APPROVED_LAN_OR_VPN_CIDR;
    deny all;

    if ($scheme != https) { return 404; }
    if ($request_method !~ ^(GET|POST|DELETE)$) { return 405; }
    if ($request_uri != /mcp) { return 404; }

    client_max_body_size 1m;
    client_body_buffer_size 1m;
    client_body_timeout 30s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 310s;
    send_timeout 30s;

    proxy_http_version 1.1;
    proxy_pass https://REPLACE_WITH_EXACT_BACKEND_PRIVATE_IP:8443/mcp;
    proxy_ssl_server_name on;
    proxy_ssl_name REPLACE_WITH_BACKEND_TLS_NAME;
    proxy_ssl_trusted_certificate REPLACE_WITH_PINNED_BACKEND_CA_FILE;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;

    proxy_pass_request_headers off;
    proxy_set_header Host REPLACE_WITH_PRIVATE_TLS_HOSTNAME;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_set_header Accept $http_accept;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Content-Length $http_content_length;
    proxy_set_header MCP-Protocol-Version $http_mcp_protocol_version;
    proxy_set_header MCP-Session-Id $http_mcp_session_id;
    proxy_set_header Last-Event-ID $http_last_event_id;
    proxy_set_header Connection "";

    proxy_request_buffering on;
    proxy_buffering off;
    gzip off;
    proxy_cache off;
    proxy_next_upstream off;
    proxy_redirect off;
    access_log off;
}

location / {
    return 404;
}
