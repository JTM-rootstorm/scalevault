# Replace every placeholder locally. Install as
# /etc/kivra-memory/memory-codex-ingress.env with owner root:root and mode 0600.
KIVRA_MEMORY_SERVER_PROFILE=codex_private_ingress
KIVRA_MEMORY_DATABASE_URL=postgresql+psycopg://kivra_memory_api:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@%2Frun%2Fpostgresql/kivra_memory
KIVRA_MEMORY_CODEX_INGRESS_HOST=REPLACE_WITH_EXACT_PRIVATE_LISTENER_IP
KIVRA_MEMORY_CODEX_INGRESS_PORT=8443
KIVRA_MEMORY_CODEX_INGRESS_EXTERNAL_HOSTNAME=REPLACE_WITH_PRIVATE_TLS_HOSTNAME
KIVRA_MEMORY_CODEX_INGRESS_TRUSTED_PROXY_CIDRS='["REPLACE_WITH_EXACT_NPM_EGRESS_CIDR"]'
KIVRA_MEMORY_CODEX_INGRESS_MAX_CONCURRENCY=4
KIVRA_MEMORY_METRICS_ENABLED=false
