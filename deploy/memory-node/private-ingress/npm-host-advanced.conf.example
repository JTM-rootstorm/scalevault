# Paste this entire template into the Proxy Host's Advanced field.
# Keep exactly one NPM Custom Location for /mcp. This regex catch-all rejects
# every other application path without colliding with NPM's generated location
# / block. NPM's higher-priority static ACME challenge handler remains separate.

# Replace NPM's inherited RFC1918 real-IP trust with a non-TCP source. This
# prevents client-supplied X-Real-IP from changing the address used by the
# source-CIDR Access List while retaining NPM's generated upstream headers.
set_real_ip_from unix:;
real_ip_recursive off;

location ~ ^/(?!mcp$) {
    access_log off;
    return 404;
}
