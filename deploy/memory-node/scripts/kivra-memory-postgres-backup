#!/usr/bin/python3
"""Strict encrypted PostgreSQL physical-backup and WAL transport helper.

This entry point intentionally has no environment-variable configuration.  Its
installed paths form part of the reviewed deployment contract.  Tests may load
the module and replace constants, but production invocations cannot redirect a
backup through ambient state.
"""

from __future__ import annotations

import argparse
import datetime as dt
import grp
import hashlib
import json
import os
import pwd
import re
import secrets
import shutil
import stat
import subprocess
import tarfile
from contextlib import suppress
from pathlib import Path, PurePosixPath
from typing import IO, Any, Never

PG_BINDIR = Path("/usr/lib/postgresql/17/bin")
PG_DATA = Path("/mnt/memory/kivra-memory/postgresql/17/main")
PG_WAL = PG_DATA / "pg_wal"
PG_SOCKET = Path("/run/postgresql")
PG_PORT = 5432
PG_DATABASE = "kivra_memory"
PG_BACKUP_ROLE = "memory_backup"
BACKUP_MOUNT = Path("/mnt/memory-backup")
PLAINTEXT_STAGING_MOUNT = Path("/mnt/memory-backup-staging")
STORE = BACKUP_MOUNT / "kivra-memory-postgres"
BASE_ROOT = STORE / "base"
WAL_ROOT = STORE / "wal"
STATUS_ROOT = STORE / "status"
VERIFICATION_ROOT = STORE / "verification"
STAGING_ROOT = STORE / ".staging"
RECOVERY_MOUNT = Path("/mnt/memory-recovery")
RECIPIENT_FILE = Path("/etc/kivra-memory/backup-age-recipient")
IDENTITY_FILE = Path("/etc/kivra-memory/backup-age-identity")
RELEASE_FILE = Path("/opt/kivra-memory/app/REVISION")
CONFIG_DIGEST_FILE = Path("/etc/kivra-memory/recovery-configuration.sha256")
AGE = Path("/usr/bin/age")
HELPER_PATH = Path("/usr/local/libexec/kivra-memory-postgres-backup")

BACKUP_ID_RE = re.compile(r"\A[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}\Z")
WAL_RE = re.compile(r"\A(?:[0-9A-F]{24}(?:\.[0-9A-F]{8}\.backup)?|[0-9A-F]{8}\.history)\Z")
TARGET_NAME_RE = re.compile(r"\A[A-Za-z][A-Za-z0-9_.-]{0,62}\Z")
LSN_RE = re.compile(r"\A[0-9A-F]+/[0-9A-F]+\Z")
SHA256_RE = re.compile(r"\A[0-9a-f]{64}\Z")
AGE_RECIPIENT_RE = re.compile(r"\Aage1[023456789acdefghjklmnpqrstuvwxyz]{20,100}\Z")
MANIFEST_VERSION = 1
CHUNK = 1024 * 1024
MAX_TAR_MEMBERS = 200_000
MAX_TAR_MEMBER_BYTES = 2 * 1024**4
MAX_TAR_EXPANDED_BYTES = 8 * 1024**4
MAX_TAR_ARCHIVE_BYTES = 9 * 1024**4
MAX_TAR_PATH_BYTES = 4096
MAX_TAR_COMPONENT_BYTES = 255
MAX_TAR_DEPTH = 32
STORE_DIRECTORY_MODE = 0o770
STORE_FILE_MODE = 0o640
STORE_OWNER = "memory-backup"
STORE_GROUP = "kivra-backup"
RECOVERY_GROUP = "memory-recovery"


class BackupError(RuntimeError):
    """A content-free, operator-actionable backup failure."""


def _fail(code: str) -> Never:
    raise BackupError(code)


def _log(event: str, result: str, object_id: str = "none") -> None:
    safe = re.compile(r"\A[a-z0-9_.:-]{1,96}\Z")
    if not all(safe.fullmatch(value) for value in (event, result, object_id)):
        _fail("internal_log_value_invalid")
    print(f"backup_event={event} result={result} object_id={object_id}", flush=True)


def _resolved(path: Path, *, must_exist: bool = True) -> Path:
    try:
        return path.resolve(strict=must_exist)
    except (OSError, RuntimeError) as exc:
        raise BackupError("path_resolution_failed") from exc


def _require_exact_mount(path: Path, *, writable: bool) -> None:
    resolved = _resolved(path)
    if resolved != path or not path.is_dir() or not os.path.ismount(path):
        _fail("required_mount_missing")
    probe_mode = os.W_OK | os.X_OK if writable else os.R_OK | os.X_OK
    if not os.access(path, probe_mode):
        _fail("required_mount_access_denied")


def _require_directory(path: Path, *, mode: int | None = None) -> None:
    try:
        info = path.lstat()
    except OSError as exc:
        raise BackupError("required_directory_missing") from exc
    if not stat.S_ISDIR(info.st_mode) or path.is_symlink() or _resolved(path) != path:
        _fail("directory_unsafe")
    if mode is not None and stat.S_IMODE(info.st_mode) != mode:
        _fail("directory_mode_invalid")


def _require_owned(path: Path, *, owner: str, group: str, mode: int) -> None:
    try:
        info = path.lstat()
        expected_uid = pwd.getpwnam(owner).pw_uid
        expected_gid = grp.getgrnam(group).gr_gid
    except (KeyError, OSError) as exc:
        raise BackupError("storage_identity_invalid") from exc
    if info.st_uid != expected_uid or info.st_gid != expected_gid:
        _fail("storage_owner_invalid")
    if stat.S_IMODE(info.st_mode) != mode:
        _fail("storage_mode_invalid")


def _require_fd_owned(descriptor: int, *, owner: str, group: str, mode: int) -> None:
    try:
        info = os.fstat(descriptor)
        expected_uid = pwd.getpwnam(owner).pw_uid
        expected_gid = grp.getgrnam(group).gr_gid
    except (KeyError, OSError) as exc:
        raise BackupError("storage_identity_invalid") from exc
    if (
        info.st_uid != expected_uid
        or info.st_gid != expected_gid
        or stat.S_IMODE(info.st_mode) != mode
    ):
        _fail("storage_owner_invalid")


def _ensure_store(*, staging_writable: bool = True) -> None:
    _require_exact_mount(BACKUP_MOUNT, writable=False)
    _require_owned(BACKUP_MOUNT, owner="root", group=STORE_GROUP, mode=0o750)
    contracts = {
        STORE: (STORE_OWNER, STORE_GROUP, 0o2750),
        BASE_ROOT: (STORE_OWNER, STORE_GROUP, 0o2750),
        WAL_ROOT: (STORE_OWNER, STORE_GROUP, 0o2770),
        STATUS_ROOT: (STORE_OWNER, STORE_GROUP, 0o2770),
        VERIFICATION_ROOT: (RECOVERY_GROUP, STORE_GROUP, 0o2750),
        STAGING_ROOT: (STORE_OWNER, STORE_GROUP, 0o2770),
    }
    for path, (owner, group, mode) in contracts.items():
        _require_directory(path, mode=mode)
        _require_owned(path, owner=owner, group=group, mode=mode)
    if not os.access(STORE, os.R_OK | os.X_OK):
        _fail("store_access_denied")
    writable_paths = (STATUS_ROOT, STAGING_ROOT) if staging_writable else (STATUS_ROOT,)
    if not all(os.access(path, os.W_OK | os.X_OK) for path in writable_paths):
        _fail("store_access_denied")


def _require_regular_file(
    path: Path, *, max_bytes: int, private: bool = False, mode: int | None = None
) -> None:
    try:
        info = path.lstat()
    except OSError as exc:
        raise BackupError("required_file_missing") from exc
    if not stat.S_ISREG(info.st_mode) or path.is_symlink() or info.st_nlink != 1:
        _fail("file_unsafe")
    if info.st_size <= 0 or info.st_size > max_bytes:
        _fail("file_size_invalid")
    if private and stat.S_IMODE(info.st_mode) & 0o077:
        _fail("private_file_mode_invalid")
    if mode is not None and stat.S_IMODE(info.st_mode) != mode:
        _fail("file_mode_invalid")


def _read_small_text(path: Path, *, code: str, max_bytes: int = 4096) -> str:
    _require_regular_file(path, max_bytes=max_bytes)
    try:
        value = path.read_text(encoding="ascii").strip()
    except (OSError, UnicodeError) as exc:
        raise BackupError(code) from exc
    if not value or any(ord(char) < 0x20 for char in value):
        _fail(code)
    return value


def _validate_recipient() -> None:
    _require_owned(RECIPIENT_FILE, owner="root", group=STORE_GROUP, mode=0o640)
    value = _read_small_text(RECIPIENT_FILE, code="recipient_invalid", max_bytes=256)
    if not AGE_RECIPIENT_RE.fullmatch(value):
        _fail("recipient_invalid")
    _require_executable(AGE)


def _validate_identity() -> None:
    _require_regular_file(IDENTITY_FILE, max_bytes=4096, private=True)
    _require_owned(IDENTITY_FILE, owner=RECOVERY_GROUP, group=RECOVERY_GROUP, mode=0o600)
    _require_executable(AGE)


def _deployment_metadata() -> tuple[str, str]:
    _require_owned(RELEASE_FILE, owner="root", group="root", mode=0o644)
    release = _read_small_text(RELEASE_FILE, code="release_metadata_invalid", max_bytes=256)
    _require_owned(CONFIG_DIGEST_FILE, owner="root", group="root", mode=0o644)
    config_digest = _read_small_text(
        CONFIG_DIGEST_FILE, code="configuration_metadata_invalid", max_bytes=256
    )
    if not re.fullmatch(r"[0-9a-f]{40,64}", release) or not SHA256_RE.fullmatch(config_digest):
        _fail("recovery_metadata_invalid")
    return release, config_digest


def _require_executable(path: Path) -> None:
    if _resolved(path) != path or not path.is_file() or not os.access(path, os.X_OK):
        _fail("executable_invalid")


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            while block := handle.read(CHUNK):
                digest.update(block)
    except OSError as exc:
        raise BackupError("object_read_failed") from exc
    return digest.hexdigest()


def _sha256_fd(descriptor: int, *, max_bytes: int) -> str:
    return _stream_stable_fd(descriptor, None, max_bytes=max_bytes)


def _read_fd(descriptor: int, *, max_bytes: int) -> bytes:
    before = os.fstat(descriptor)
    _validate_source_info(before, max_bytes=max_bytes)
    os.lseek(descriptor, 0, os.SEEK_SET)
    chunks = []
    total = 0
    while block := os.read(descriptor, min(CHUNK, max_bytes + 1 - total)):
        total += len(block)
        if total > max_bytes:
            _fail("file_size_invalid")
        chunks.append(block)
    if _source_fingerprint(before) != _source_fingerprint(os.fstat(descriptor)):
        _fail("source_changed_during_read")
    return b"".join(chunks)


def _source_fingerprint(info: os.stat_result) -> tuple[int, int, int, int, int, int, int]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def _validate_source_info(
    info: os.stat_result, *, max_bytes: int, allow_empty: bool = False
) -> None:
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        _fail("source_file_unsafe")
    if info.st_size < (0 if allow_empty else 1) or info.st_size > max_bytes:
        _fail("source_file_size_invalid")


def _stream_stable_fd(source_fd: int, sink: IO[bytes] | None, *, max_bytes: int) -> str:
    before = os.fstat(source_fd)
    _validate_source_info(before, max_bytes=max_bytes)
    digest = hashlib.sha256()
    consumed = 0
    os.lseek(source_fd, 0, os.SEEK_SET)
    while block := os.read(source_fd, CHUNK):
        consumed += len(block)
        if consumed > max_bytes:
            _fail("source_file_size_invalid")
        digest.update(block)
        if sink is not None:
            sink.write(block)
    after = os.fstat(source_fd)
    if consumed != before.st_size or _source_fingerprint(before) != _source_fingerprint(after):
        _fail("source_changed_during_read")
    return digest.hexdigest()


def _fsync_file(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _fsync_dir(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _write_json_exclusive(path: Path, value: dict[str, Any]) -> None:
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            STORE_FILE_MODE,
        )
        os.fchmod(descriptor, STORE_FILE_MODE)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    except OSError as exc:
        raise BackupError("metadata_publish_failed") from exc


def _write_private_json(path: Path, value: dict[str, Any]) -> None:
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    except OSError as exc:
        raise BackupError("metadata_stage_failed") from exc


def _replace_json(path: Path, value: dict[str, Any]) -> None:
    temp = path.with_name(f".{path.name}.{secrets.token_hex(8)}.tmp")
    _write_json_exclusive(temp, value)
    os.replace(temp, path)
    _fsync_dir(path.parent)


def _read_index(path: Path, *, kind: str) -> dict[str, Any]:
    _require_regular_file(path, max_bytes=64 * 1024, mode=STORE_FILE_MODE)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise BackupError("manifest_invalid") from exc
    return _validate_index(value, kind=kind)


def _validate_index(value: object, *, kind: str) -> dict[str, Any]:
    if not isinstance(value, dict) or value.get("manifest_version") != MANIFEST_VERSION:
        _fail("manifest_invalid")
    if value.get("kind") != kind:
        _fail("manifest_invalid")
    common = {
        "created_at",
        "kind",
        "manifest_ciphertext_sha256",
        "manifest_version",
        "object_id",
    }
    allowed = (
        common | {"ciphertext_sha256", "plaintext_sha256"}
        if kind == "wal"
        else common | {"verification"}
    )
    if set(value) != allowed:
        _fail("manifest_invalid")
    manifest_sha = value.get("manifest_ciphertext_sha256")
    if not isinstance(manifest_sha, str) or not SHA256_RE.fullmatch(manifest_sha):
        _fail("manifest_invalid")
    if kind == "wal":
        for field in ("ciphertext_sha256", "plaintext_sha256"):
            if not isinstance(value.get(field), str) or not SHA256_RE.fullmatch(value[field]):
                _fail("manifest_invalid")
    return value


def _encrypted_manifest(
    root: Path, index: dict[str, Any], *, kind: str, temporary_root: Path
) -> dict[str, Any]:
    encrypted = root / "recovery-manifest.json.age"
    _require_regular_file(encrypted, max_bytes=1024 * 1024, mode=STORE_FILE_MODE)
    if _sha256(encrypted) != index.get("manifest_ciphertext_sha256"):
        _fail("manifest_ciphertext_digest_mismatch")
    temporary = temporary_root / f"manifest-{secrets.token_hex(8)}.json"
    try:
        _decrypt_file(encrypted, temporary)
        _require_regular_file(temporary, max_bytes=1024 * 1024, private=True)
        try:
            value = json.loads(temporary.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise BackupError("manifest_invalid") from exc
    finally:
        with suppress(OSError):
            temporary.unlink()
    return _validate_manifest(value, index=index, kind=kind)


def _validate_manifest(value: object, *, index: dict[str, Any], kind: str) -> dict[str, Any]:
    if not isinstance(value, dict) or value.get("manifest_version") != MANIFEST_VERSION:
        _fail("manifest_invalid")
    if value.get("kind") != kind or value.get("object_id") != index.get("object_id"):
        _fail("manifest_invalid")
    common = {
        "ciphertext_sha256",
        "created_at",
        "kind",
        "manifest_version",
        "object_id",
        "plaintext_sha256",
    }
    allowed = (
        common
        if kind == "wal"
        else common
        | {
            "configuration_manifest_sha256",
            "end_lsn",
            "migration_revision",
            "postgres_major",
            "release_revision",
            "start_lsn",
            "start_wal",
            "system_identifier",
            "timeline",
            "verified_at",
            "verification",
        }
    )
    if set(value) != allowed:
        _fail("manifest_invalid")
    for field in ("ciphertext_sha256", "plaintext_sha256"):
        if not isinstance(value.get(field), str) or not SHA256_RE.fullmatch(value[field]):
            _fail("manifest_invalid")
    try:
        created = dt.datetime.fromisoformat(value["created_at"])
    except (KeyError, TypeError, ValueError) as exc:
        raise BackupError("manifest_invalid") from exc
    if created.tzinfo is None:
        _fail("manifest_invalid")
    if kind == "base_backup" and (
        value.get("postgres_major") != 17
        or not isinstance(value.get("timeline"), int)
        or not 1 <= value["timeline"] <= 0xFFFFFFFF
        or not isinstance(value.get("system_identifier"), str)
        or not value["system_identifier"].isdigit()
        or not isinstance(value.get("start_lsn"), str)
        or not LSN_RE.fullmatch(value["start_lsn"])
        or not isinstance(value.get("end_lsn"), str)
        or not LSN_RE.fullmatch(value["end_lsn"])
        or not isinstance(value.get("start_wal"), str)
        or not re.fullmatch(r"[0-9A-F]{24}", value["start_wal"])
        or not isinstance(value.get("migration_revision"), str)
        or not re.fullmatch(r"[a-z0-9_]{1,64}", value["migration_revision"])
        or not isinstance(value.get("release_revision"), str)
        or not re.fullmatch(r"[0-9a-f]{40,64}", value["release_revision"])
        or not isinstance(value.get("configuration_manifest_sha256"), str)
        or not SHA256_RE.fullmatch(value["configuration_manifest_sha256"])
        or value.get("verification") != "pg_verifybackup_ok"
    ):
        _fail("manifest_invalid")
    return value


def _publish_encrypted_manifest(stage: Path, value: dict[str, Any]) -> str:
    plaintext = stage / ".recovery-manifest.json"
    encrypted = stage / "recovery-manifest.json.age"
    _write_private_json(plaintext, value)
    try:
        _encrypt_file(plaintext, encrypted)
    finally:
        with suppress(OSError):
            plaintext.unlink()
    return _sha256(encrypted)


def _new_id() -> str:
    stamp = dt.datetime.now(dt.UTC).strftime("%Y%m%dT%H%M%SZ")
    return f"{stamp}-{secrets.token_hex(8)}"


def _run(arguments: list[str], *, stdin: int | None = None, stdout: int | None = None) -> None:
    try:
        completed = subprocess.run(
            arguments,
            stdin=stdin,
            stdout=stdout,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            check=False,
        )
    except OSError as exc:
        raise BackupError("dependency_execution_failed") from exc
    if completed.returncode != 0:
        _fail("dependency_failed")


def _capture(arguments: list[str], *, code: str) -> str:
    try:
        completed = subprocess.run(
            arguments,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            check=False,
            text=True,
            encoding="ascii",
        )
    except OSError as exc:
        raise BackupError("dependency_execution_failed") from exc
    value = completed.stdout.strip()
    if completed.returncode != 0 or not value or any(ord(char) < 0x20 for char in value):
        _fail(code)
    return value


def _encrypt_file(source: Path, destination: Path) -> None:
    _validate_recipient()
    descriptor = os.open(
        destination,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        STORE_FILE_MODE,
    )
    os.fchmod(descriptor, STORE_FILE_MODE)
    source_fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        _run([str(AGE), "-R", str(RECIPIENT_FILE)], stdin=source_fd, stdout=descriptor)
        os.fsync(descriptor)
    except BaseException:
        with suppress(OSError):
            destination.unlink()
        raise
    finally:
        os.close(source_fd)
        os.close(descriptor)


def _encrypt_fd(source_fd: int, destination: Path, *, max_bytes: int) -> str:
    _validate_recipient()
    descriptor = os.open(
        destination,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        STORE_FILE_MODE,
    )
    os.fchmod(descriptor, STORE_FILE_MODE)
    process: subprocess.Popen[bytes] | None = None
    success = False
    try:
        process = subprocess.Popen(
            [str(AGE), "-R", str(RECIPIENT_FILE)],
            stdin=subprocess.PIPE,
            stdout=descriptor,
            stderr=subprocess.DEVNULL,
            close_fds=True,
        )
        if process.stdin is None:
            _fail("dependency_execution_failed")
        try:
            plaintext_sha = _stream_stable_fd(source_fd, process.stdin, max_bytes=max_bytes)
            process.stdin.close()
        except BaseException:
            process.kill()
            process.wait()
            raise
        if process.wait() != 0:
            _fail("dependency_failed")
        os.fsync(descriptor)
        success = True
        return plaintext_sha
    except (OSError, BrokenPipeError) as exc:
        if process is not None and process.poll() is None:
            process.kill()
            process.wait()
        raise BackupError("dependency_execution_failed") from exc
    except BaseException:
        if process is not None and process.poll() is None:
            process.kill()
            process.wait()
        raise
    finally:
        os.close(descriptor)
        if not success:
            with suppress(OSError):
                destination.unlink()


def _decrypt_file(source: Path, destination: Path) -> None:
    _validate_identity()
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    source_fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        _run([str(AGE), "--decrypt", "-i", str(IDENTITY_FILE)], stdin=source_fd, stdout=descriptor)
        os.fsync(descriptor)
    except BaseException:
        with suppress(OSError):
            destination.unlink()
        raise
    finally:
        os.close(source_fd)
        os.close(descriptor)


def _decrypt_fd(source_fd: int, destination: Path) -> None:
    _validate_identity()
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.lseek(source_fd, 0, os.SEEK_SET)
        _run(
            [str(AGE), "--decrypt", "-i", str(IDENTITY_FILE)],
            stdin=source_fd,
            stdout=descriptor,
        )
        os.fsync(descriptor)
    except BaseException:
        with suppress(OSError):
            destination.unlink()
        raise
    finally:
        os.close(descriptor)


def _publish_directory(stage: Path, destination: Path) -> None:
    _fsync_dir(stage)
    try:
        os.rename(stage, destination)
    except FileExistsError as exc:
        raise BackupError("object_already_exists") from exc
    _fsync_dir(destination.parent)


def archive_wal(source_arg: str, wal_name: str) -> None:
    if not WAL_RE.fullmatch(wal_name):
        _fail("wal_name_invalid")
    source = Path(source_arg)
    if not source.is_absolute() or source.parent != PG_WAL or source.name != wal_name:
        _fail("wal_source_invalid")
    if _resolved(PG_WAL) != PG_WAL:
        _fail("wal_source_invalid")
    try:
        directory_fd = os.open(PG_WAL, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            source_fd = os.open(wal_name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
        finally:
            os.close(directory_fd)
    except OSError as exc:
        raise BackupError("wal_source_invalid") from exc
    try:
        _ensure_store()
        if not os.access(WAL_ROOT, os.W_OK | os.X_OK):
            _fail("store_access_denied")
        destination = WAL_ROOT / wal_name
        if destination.exists():
            _require_directory(destination, mode=STORE_DIRECTORY_MODE)
            index = _read_index(destination / "index.json", kind="wal")
            encrypted = destination / "segment.age"
            _require_regular_file(encrypted, max_bytes=2 * 1024 * 1024 * 1024, mode=STORE_FILE_MODE)
            recovery_manifest = destination / "recovery-manifest.json.age"
            _require_regular_file(recovery_manifest, max_bytes=1024 * 1024, mode=STORE_FILE_MODE)
            plaintext_sha = _stream_stable_fd(source_fd, None, max_bytes=1024 * 1024 * 1024)
            if (
                index.get("object_id") != wal_name
                or index.get("plaintext_sha256") != plaintext_sha
                or index.get("ciphertext_sha256") != _sha256(encrypted)
                or index.get("manifest_ciphertext_sha256") != _sha256(recovery_manifest)
            ):
                _fail("wal_duplicate_mismatch")
            _log("wal_archive", "duplicate_identical", wal_name.lower())
            return
        stage = STAGING_ROOT / f"wal-{wal_name}-{secrets.token_hex(8)}"
        stage.mkdir(mode=STORE_DIRECTORY_MODE)
        stage.chmod(STORE_DIRECTORY_MODE)
        try:
            encrypted = stage / "segment.age"
            plaintext_sha = _encrypt_fd(source_fd, encrypted, max_bytes=1024 * 1024 * 1024)
            encrypted_sha = _sha256(encrypted)
            created_at = dt.datetime.now(dt.UTC).isoformat()
            manifest_sha = _publish_encrypted_manifest(
                stage,
                {
                    "ciphertext_sha256": encrypted_sha,
                    "created_at": created_at,
                    "kind": "wal",
                    "manifest_version": MANIFEST_VERSION,
                    "object_id": wal_name,
                    "plaintext_sha256": plaintext_sha,
                },
            )
            _write_json_exclusive(
                stage / "index.json",
                {
                    "ciphertext_sha256": encrypted_sha,
                    "created_at": created_at,
                    "kind": "wal",
                    "manifest_version": MANIFEST_VERSION,
                    "manifest_ciphertext_sha256": manifest_sha,
                    "object_id": wal_name,
                    "plaintext_sha256": plaintext_sha,
                },
            )
            _publish_directory(stage, destination)
        except BaseException:
            shutil.rmtree(stage, ignore_errors=True)
            raise
    finally:
        os.close(source_fd)
    _replace_json(STATUS_ROOT / "latest-wal.json", {"object_id": wal_name, "result": "ok"})
    _log("wal_archive", "ok", wal_name.lower())


def _validate_tar_path(name: str) -> tuple[str, ...]:
    if not name or name.startswith("/") or "\\" in name:
        _fail("backup_member_unsafe")
    parts = tuple(name.split("/"))
    if (
        any(part in {"", ".", ".."} for part in parts)
        or len(parts) > MAX_TAR_DEPTH
        or len(name.encode("utf-8")) > MAX_TAR_PATH_BYTES
        or any(len(part.encode("utf-8")) > MAX_TAR_COMPONENT_BYTES for part in parts)
        or PurePosixPath(name).parts != parts
    ):
        _fail("backup_member_unsafe")
    return parts


def _normalized_tar_info(name: str, info: os.stat_result) -> tarfile.TarInfo:
    member = tarfile.TarInfo(name)
    member.uid = 0
    member.gid = 0
    member.uname = ""
    member.gname = ""
    member.mtime = 0
    member.pax_headers = {}
    if stat.S_ISDIR(info.st_mode):
        member.type = tarfile.DIRTYPE
        member.mode = 0o700
        member.size = 0
    elif stat.S_ISREG(info.st_mode):
        # PostgreSQL physical backups legitimately contain empty regular files.
        # Other authenticated inputs remain non-empty by default.
        _validate_source_info(info, max_bytes=MAX_TAR_MEMBER_BYTES, allow_empty=True)
        member.type = tarfile.REGTYPE
        member.mode = 0o600
        member.size = info.st_size
    else:
        _fail("backup_member_unsafe")
    return member


def _add_tree(
    archive: tarfile.TarFile,
    directory_fd: int,
    prefix: tuple[str, ...],
    totals: list[int],
) -> None:
    try:
        names = sorted(os.listdir(directory_fd))
    except OSError as exc:
        raise BackupError("backup_source_read_failed") from exc
    for name in names:
        relative_parts = (*prefix, name)
        relative = "/".join(relative_parts)
        _validate_tar_path(relative)
        totals[0] += 1
        if totals[0] > MAX_TAR_MEMBERS:
            _fail("backup_member_count_exceeded")
        try:
            path_info = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        except OSError as exc:
            raise BackupError("backup_source_read_failed") from exc
        member = _normalized_tar_info(relative, path_info)
        totals[1] += member.size
        if totals[1] > MAX_TAR_EXPANDED_BYTES:
            _fail("backup_expanded_size_exceeded")
        if member.isdir():
            try:
                child_fd = os.open(
                    name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=directory_fd,
                )
            except OSError as exc:
                raise BackupError("backup_member_unsafe") from exc
            try:
                before = os.fstat(child_fd)
                if _source_fingerprint(path_info) != _source_fingerprint(before):
                    _fail("source_changed_during_read")
                archive.addfile(member)
                _add_tree(archive, child_fd, relative_parts, totals)
                after = os.fstat(child_fd)
                if _source_fingerprint(before) != _source_fingerprint(after):
                    _fail("source_changed_during_read")
            finally:
                os.close(child_fd)
        else:
            try:
                file_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
            except OSError as exc:
                raise BackupError("backup_member_unsafe") from exc
            try:
                before = os.fstat(file_fd)
                if _source_fingerprint(path_info) != _source_fingerprint(before):
                    _fail("source_changed_during_read")
                with os.fdopen(file_fd, "rb", closefd=False) as source_file:
                    archive.addfile(member, source_file)
                after = os.fstat(file_fd)
                if _source_fingerprint(before) != _source_fingerprint(after):
                    _fail("source_changed_during_read")
            finally:
                os.close(file_fd)


def _create_tar(source: Path, destination: Path) -> None:
    source_fd = os.open(source, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    source_before = os.fstat(source_fd)
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with (
            os.fdopen(descriptor, "wb", closefd=False) as output,
            tarfile.open(fileobj=output, mode="w|", format=tarfile.PAX_FORMAT) as archive,
        ):
            _add_tree(archive, source_fd, (), [0, 0])
        if _source_fingerprint(source_before) != _source_fingerprint(os.fstat(source_fd)):
            _fail("source_changed_during_read")
        _fsync_file(destination)
    finally:
        os.close(source_fd)
        os.close(descriptor)


def _pg_manifest_metadata(path: Path) -> tuple[str, int, str, str]:
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
        system_identifier = str(manifest["System-Identifier"])
        timeline = int(manifest["WAL-Ranges"][0]["Timeline"])
        start_lsn = str(manifest["WAL-Ranges"][0]["Start-LSN"])
        end_lsn = str(manifest["WAL-Ranges"][-1]["End-LSN"])
    except (OSError, UnicodeError, json.JSONDecodeError, KeyError, IndexError, TypeError) as exc:
        raise BackupError("postgres_manifest_invalid") from exc
    if (
        not system_identifier.isdigit()
        or not 1 <= timeline <= 0xFFFFFFFF
        or not LSN_RE.fullmatch(start_lsn)
        or not LSN_RE.fullmatch(end_lsn)
    ):
        _fail("postgres_manifest_invalid")
    return system_identifier, timeline, start_lsn, end_lsn


def _lsn_to_wal_name(lsn: str, timeline: int = 1) -> str:
    high, low = (int(part, 16) for part in lsn.split("/"))
    segment = low // 0x1000000
    return f"{timeline:08X}{high:08X}{segment:08X}"


def base_backup() -> None:
    _ensure_store()
    if not os.access(BASE_ROOT, os.W_OK | os.X_OK):
        _fail("store_access_denied")
    _require_exact_mount(PLAINTEXT_STAGING_MOUNT, writable=True)
    _require_owned(PLAINTEXT_STAGING_MOUNT, owner=STORE_OWNER, group=STORE_OWNER, mode=0o700)
    _validate_recipient()
    for binary in ("pg_basebackup", "pg_verifybackup", "psql"):
        _require_executable(PG_BINDIR / binary)
    backup_id = _new_id()
    stage = STAGING_ROOT / f"base-{backup_id}"
    plaintext_stage = PLAINTEXT_STAGING_MOUNT / backup_id
    plain = plaintext_stage / "plain"
    stage.mkdir(mode=STORE_DIRECTORY_MODE)
    stage.chmod(STORE_DIRECTORY_MODE)
    plaintext_created = False
    try:
        plaintext_stage.mkdir(mode=0o700)
        plaintext_created = True
        plain.mkdir(mode=0o700)
        migration_query = [
            str(PG_BINDIR / "psql"),
            f"--host={PG_SOCKET}",
            f"--port={PG_PORT}",
            f"--username={PG_BACKUP_ROLE}",
            f"--dbname={PG_DATABASE}",
            "--no-psqlrc",
            "--tuples-only",
            "--no-align",
            "--set=ON_ERROR_STOP=1",
            "--command=SELECT version_num FROM alembic_version",
        ]
        migration_revision = _capture(migration_query, code="migration_metadata_invalid")
        if not re.fullmatch(r"[a-z0-9_]{1,64}", migration_revision):
            _fail("migration_metadata_invalid")
        _run(
            [
                str(PG_BINDIR / "pg_basebackup"),
                f"--host={PG_SOCKET}",
                f"--port={PG_PORT}",
                f"--username={PG_BACKUP_ROLE}",
                f"--pgdata={plain}",
                "--format=plain",
                "--checkpoint=fast",
                "--wal-method=stream",
                "--manifest-checksums=SHA256",
                "--no-password",
            ]
        )
        if _capture(migration_query, code="migration_metadata_invalid") != migration_revision:
            _fail("migration_changed_during_backup")
        _run([str(PG_BINDIR / "pg_verifybackup"), "--no-parse-wal", str(plain)])
        system_id, timeline, start_lsn, end_lsn = _pg_manifest_metadata(plain / "backup_manifest")
        tar_path = plaintext_stage / "backup.tar"
        _create_tar(plain, tar_path)
        plaintext_sha = _sha256(tar_path)
        encrypted = stage / "backup.tar.age"
        _encrypt_file(tar_path, encrypted)
        encrypted_sha = _sha256(encrypted)
        shutil.rmtree(plain)
        tar_path.unlink()
        release, config_digest = _deployment_metadata()
        created_at = dt.datetime.now(dt.UTC).isoformat()
        recovery_manifest = {
            "ciphertext_sha256": encrypted_sha,
            "configuration_manifest_sha256": config_digest,
            "created_at": created_at,
            "end_lsn": end_lsn,
            "kind": "base_backup",
            "manifest_version": MANIFEST_VERSION,
            "migration_revision": migration_revision,
            "object_id": backup_id,
            "plaintext_sha256": plaintext_sha,
            "postgres_major": 17,
            "release_revision": release,
            "start_lsn": start_lsn,
            "start_wal": _lsn_to_wal_name(start_lsn, timeline),
            "system_identifier": system_id,
            "timeline": timeline,
            "verified_at": created_at,
            "verification": "pg_verifybackup_ok",
        }
        manifest_sha = _publish_encrypted_manifest(stage, recovery_manifest)
        _write_json_exclusive(
            stage / "index.json",
            {
                "created_at": created_at,
                "kind": "base_backup",
                "manifest_ciphertext_sha256": manifest_sha,
                "manifest_version": MANIFEST_VERSION,
                "object_id": backup_id,
                "verification": "source_pg_verifybackup_ok",
            },
        )
        _publish_directory(stage, BASE_ROOT / backup_id)
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise
    finally:
        if plaintext_created:
            try:
                shutil.rmtree(plaintext_stage)
                _fsync_dir(PLAINTEXT_STAGING_MOUNT)
            except OSError as exc:
                raise BackupError("plaintext_cleanup_failed") from exc
    _replace_json(STATUS_ROOT / "latest-base.json", {"object_id": backup_id, "result": "ok"})
    _log("base_backup", "ok", backup_id.lower())


def _scan_tar_fd(archive_fd: int) -> list[tuple[str, tuple[str, ...], bytes, int]]:
    expected: list[tuple[str, tuple[str, ...], bytes, int]] = []
    paths: set[str] = set()
    file_paths: set[str] = set()
    total = 0
    try:
        os.lseek(archive_fd, 0, os.SEEK_SET)
        with (
            os.fdopen(os.dup(archive_fd), "rb") as source,
            tarfile.open(fileobj=source, mode="r:") as archive,
        ):
            for member in archive:
                if len(expected) >= MAX_TAR_MEMBERS:
                    _fail("backup_member_count_exceeded")
                parts = _validate_tar_path(member.name)
                if member.name in paths:
                    _fail("backup_member_duplicate")
                paths.add(member.name)
                sparse = getattr(member, "sparse", None)
                if member.type == tarfile.GNUTYPE_SPARSE or sparse is not None:
                    _fail("backup_member_sparse")
                if member.isdir():
                    if member.size != 0:
                        _fail("backup_member_invalid")
                    kind = tarfile.DIRTYPE
                elif member.isreg():
                    if member.size < 0 or member.size > MAX_TAR_MEMBER_BYTES:
                        _fail("backup_member_size_exceeded")
                    total += member.size
                    if total > MAX_TAR_EXPANDED_BYTES:
                        _fail("backup_expanded_size_exceeded")
                    kind = tarfile.REGTYPE
                    file_paths.add(member.name)
                else:
                    _fail("backup_member_unsafe")
                expected.append((member.name, parts, kind, member.size))
    except (OSError, tarfile.TarError) as exc:
        raise BackupError("backup_archive_invalid") from exc
    for _name, parts, _kind, _size in expected:
        for depth in range(1, len(parts)):
            if "/".join(parts[:depth]) in file_paths:
                _fail("backup_member_unsafe")
    return expected


def _scan_tar(archive_path: Path) -> list[tuple[str, tuple[str, ...], bytes, int]]:
    descriptor = os.open(archive_path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        return _scan_tar_fd(descriptor)
    finally:
        os.close(descriptor)


def _directory_identity(info: os.stat_result) -> tuple[int, int, int, int, int]:
    if not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o700:
        _fail("recovery_directory_unsafe")
    if info.st_uid != os.geteuid() or info.st_gid != os.getegid():
        _fail("recovery_directory_unsafe")
    return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid)


def _pinned_parent(
    root_fd: int, parts: tuple[str, ...]
) -> tuple[int, tuple[tuple[str, tuple[int, int, int, int, int]], ...]]:
    current_fd = os.dup(root_fd)
    chain: list[tuple[str, tuple[int, int, int, int, int]]] = []
    try:
        for component in parts:
            try:
                os.mkdir(component, mode=0o700, dir_fd=current_fd)
                os.fsync(current_fd)
            except FileExistsError:
                pass
            try:
                child_fd = os.open(
                    component,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                raise BackupError("recovery_directory_unsafe") from exc
            identity = _directory_identity(os.fstat(child_fd))
            chain.append((component, identity))
            os.close(current_fd)
            current_fd = child_fd
        return current_fd, tuple(chain)
    except BaseException:
        os.close(current_fd)
        raise


def _revalidate_pinned_chain(
    root_fd: int, chain: tuple[tuple[str, tuple[int, int, int, int, int]], ...]
) -> None:
    current_fd = os.dup(root_fd)
    try:
        for component, expected in chain:
            try:
                child_fd = os.open(
                    component,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                raise BackupError("recovery_directory_changed") from exc
            os.close(current_fd)
            current_fd = child_fd
            if _directory_identity(os.fstat(current_fd)) != expected:
                _fail("recovery_directory_changed")
    finally:
        os.close(current_fd)


def _safe_extract(archive_path: Path, destination: Path) -> None:
    archive_fd = os.open(archive_path, os.O_RDONLY | os.O_NOFOLLOW)
    root_fd = os.open(destination, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        _directory_identity(os.fstat(root_fd))
        before = os.fstat(archive_fd)
        _validate_source_info(before, max_bytes=MAX_TAR_ARCHIVE_BYTES)
        expected = _scan_tar_fd(archive_fd)
        if _source_fingerprint(before) != _source_fingerprint(os.fstat(archive_fd)):
            _fail("backup_archive_changed")
        os.lseek(archive_fd, 0, os.SEEK_SET)
        with (
            os.fdopen(os.dup(archive_fd), "rb") as source,
            tarfile.open(fileobj=source, mode="r:") as archive,
        ):
            count = 0
            for index, member in enumerate(archive):
                count += 1
                if index >= len(expected):
                    _fail("backup_archive_changed")
                name, parts, kind, size = expected[index]
                actual_kind = tarfile.DIRTYPE if member.isdir() else tarfile.REGTYPE
                if (member.name, actual_kind, member.size) != (name, kind, size):
                    _fail("backup_archive_changed")
                parent_fd, chain = _pinned_parent(root_fd, parts[:-1])
                try:
                    _revalidate_pinned_chain(root_fd, chain)
                    if kind == tarfile.DIRTYPE:
                        try:
                            os.mkdir(parts[-1], mode=0o700, dir_fd=parent_fd)
                            os.fsync(parent_fd)
                        except FileExistsError:
                            pass
                        child_fd = os.open(
                            parts[-1],
                            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=parent_fd,
                        )
                        try:
                            identity = _directory_identity(os.fstat(child_fd))
                        finally:
                            os.close(child_fd)
                        _revalidate_pinned_chain(root_fd, (*chain, (parts[-1], identity)))
                    else:
                        descriptor = os.open(
                            parts[-1],
                            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                            0o600,
                            dir_fd=parent_fd,
                        )
                        try:
                            # Opening the final file is itself a race boundary.
                            # Revalidate the path chain before writing one byte.
                            _revalidate_pinned_chain(root_fd, chain)
                            extracted = archive.extractfile(member)
                            if extracted is None:
                                _fail("backup_member_invalid")
                            remaining = size
                            with os.fdopen(descriptor, "wb") as output:
                                descriptor = -1
                                while remaining:
                                    block = extracted.read(min(CHUNK, remaining))
                                    if not block:
                                        _fail("backup_member_truncated")
                                    output.write(block)
                                    remaining -= len(block)
                                output.flush()
                                os.fsync(output.fileno())
                            os.fsync(parent_fd)
                            _revalidate_pinned_chain(root_fd, chain)
                        except BaseException:
                            if descriptor >= 0:
                                os.close(descriptor)
                            with suppress(OSError):
                                os.unlink(parts[-1], dir_fd=parent_fd)
                                os.fsync(parent_fd)
                            raise
                    _revalidate_pinned_chain(root_fd, chain)
                finally:
                    os.close(parent_fd)
            if count != len(expected):
                _fail("backup_archive_changed")
        if _source_fingerprint(before) != _source_fingerprint(os.fstat(archive_fd)):
            _fail("backup_archive_changed")
    except (OSError, tarfile.TarError) as exc:
        raise BackupError("backup_archive_invalid") from exc
    finally:
        os.close(root_fd)
        os.close(archive_fd)


def _require_recovery_destination(destination: Path) -> bool:
    _require_exact_mount(RECOVERY_MOUNT, writable=True)
    _require_owned(RECOVERY_MOUNT, owner="root", group=RECOVERY_GROUP, mode=0o770)
    if (
        not destination.is_absolute()
        or destination.parent != RECOVERY_MOUNT
        or not re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,62}", destination.name)
    ):
        _fail("recovery_destination_invalid")
    if destination == PG_DATA or _resolved(destination, must_exist=False) == _resolved(
        PG_DATA, must_exist=False
    ):
        _fail("canonical_destination_forbidden")
    existed = destination.exists()
    if existed:
        _require_directory(destination, mode=0o700)
        if any(destination.iterdir()):
            _fail("recovery_destination_not_empty")
    else:
        destination.mkdir(mode=0o700)
    return existed


def _clean_failed_restore(destination: Path, *, preserve_root: bool) -> None:
    shutil.rmtree(destination, ignore_errors=True)
    if preserve_root:
        destination.mkdir(mode=0o700)


def _base_object(backup_id: str) -> tuple[Path, dict[str, Any]]:
    if not BACKUP_ID_RE.fullmatch(backup_id):
        _fail("backup_id_invalid")
    root = BASE_ROOT / backup_id
    _require_directory(root, mode=STORE_DIRECTORY_MODE)
    index = _read_index(root / "index.json", kind="base_backup")
    if index.get("object_id") != backup_id:
        _fail("manifest_invalid")
    manifest = _encrypted_manifest(root, index, kind="base_backup", temporary_root=RECOVERY_MOUNT)
    if manifest.get("object_id") != backup_id or manifest.get("postgres_major") != 17:
        _fail("manifest_invalid")
    encrypted = root / "backup.tar.age"
    _require_regular_file(encrypted, max_bytes=16 * 1024**4, mode=STORE_FILE_MODE)
    if _sha256(encrypted) != manifest["ciphertext_sha256"]:
        _fail("ciphertext_digest_mismatch")
    return encrypted, manifest


def prepare_restore(backup_id: str, destination_arg: str, target_kind: str, target: str) -> None:
    _require_exact_mount(BACKUP_MOUNT, writable=False)
    destination = Path(destination_arg)
    destination_existed = _require_recovery_destination(destination)
    encrypted, manifest = _base_object(backup_id)
    tar_path = RECOVERY_MOUNT / f".{backup_id}.{secrets.token_hex(8)}.tar"
    try:
        _decrypt_file(encrypted, tar_path)
        if _sha256(tar_path) != manifest["plaintext_sha256"]:
            _fail("plaintext_digest_mismatch")
        _safe_extract(tar_path, destination)
        _require_executable(PG_BINDIR / "pg_verifybackup")
        _run([str(PG_BINDIR / "pg_verifybackup"), "--no-parse-wal", str(destination)])
        _write_recovery_settings(destination, target_kind, target)
        (destination / "recovery.signal").touch(mode=0o600, exist_ok=False)
        _fsync_file(destination / "recovery.signal")
        _fsync_dir(destination)
    except BaseException:
        _clean_failed_restore(destination, preserve_root=destination_existed)
        raise
    finally:
        with suppress(OSError):
            tar_path.unlink()
    _log("prepare_restore", "ok", backup_id.lower())


def _write_recovery_settings(destination: Path, kind: str, target: str) -> None:
    if kind == "name":
        if not TARGET_NAME_RE.fullmatch(target):
            _fail("recovery_target_invalid")
        setting = "recovery_target_name"
    elif kind == "lsn":
        if not LSN_RE.fullmatch(target):
            _fail("recovery_target_invalid")
        setting = "recovery_target_lsn"
    elif kind == "time":
        try:
            parsed = dt.datetime.fromisoformat(target)
        except ValueError as exc:
            raise BackupError("recovery_target_invalid") from exc
        if parsed.tzinfo is None or parsed.utcoffset() != dt.timedelta(0):
            _fail("recovery_target_invalid")
        setting = "recovery_target_time"
    else:
        _fail("recovery_target_invalid")
    escaped = target.replace("'", "''")
    if "\n" in escaped or "\r" in escaped:
        _fail("recovery_target_invalid")
    wal_destination = destination / "pg_wal" / "%f"
    command = f"{HELPER_PATH} restore-wal %f {wal_destination}"
    content = (
        f"restore_command = '{command}'\n"
        f"{setting} = '{escaped}'\n"
        "recovery_target_action = 'pause'\n"
    ).encode("ascii")
    path = destination / "postgresql.auto.conf"
    descriptor = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "ab") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())


def restore_wal(wal_name: str, destination_arg: str) -> None:
    if not WAL_RE.fullmatch(wal_name):
        _fail("wal_name_invalid")
    destination = Path(destination_arg)
    if not destination.is_absolute() or destination.name != wal_name:
        _fail("wal_restore_destination_invalid")
    _require_exact_mount(RECOVERY_MOUNT, writable=True)
    _require_owned(RECOVERY_MOUNT, owner="root", group=RECOVERY_GROUP, mode=0o770)
    try:
        relative = destination.relative_to(RECOVERY_MOUNT)
    except ValueError as exc:
        raise BackupError("wal_restore_destination_invalid") from exc
    if len(relative.parts) < 3 or not re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,62}", relative.parts[0]):
        _fail("wal_restore_destination_invalid")
    drill_root = RECOVERY_MOUNT / relative.parts[0]
    if (
        _resolved(drill_root) != drill_root
        or RECOVERY_MOUNT not in _resolved(destination.parent).parents
    ):
        _fail("wal_restore_destination_invalid")
    _require_directory(WAL_ROOT, mode=0o2770)
    _require_owned(WAL_ROOT, owner=STORE_OWNER, group=STORE_GROUP, mode=0o2770)
    wal_root_fd = os.open(WAL_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        object_fd = os.open(
            wal_name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
            dir_fd=wal_root_fd,
        )
    except OSError as exc:
        os.close(wal_root_fd)
        raise BackupError("wal_object_invalid") from exc
    os.close(wal_root_fd)
    try:
        _require_fd_owned(object_fd, owner="postgres", group=STORE_GROUP, mode=STORE_DIRECTORY_MODE)
    except BaseException:
        os.close(object_fd)
        raise
    member_fds: list[int] = []
    try:
        for name in ("index.json", "recovery-manifest.json.age", "segment.age"):
            try:
                descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=object_fd)
            except OSError as exc:
                raise BackupError("wal_object_invalid") from exc
            info = os.fstat(descriptor)
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) != STORE_FILE_MODE
            ):
                os.close(descriptor)
                _fail("wal_object_invalid")
            member_fds.append(descriptor)
        index_fd, manifest_fd, encrypted_fd = member_fds
        try:
            index_value = json.loads(_read_fd(index_fd, max_bytes=64 * 1024))
        except (UnicodeError, json.JSONDecodeError) as exc:
            raise BackupError("manifest_invalid") from exc
        index = _validate_index(index_value, kind="wal")
        manifest_before = os.fstat(manifest_fd)
        if _sha256_fd(manifest_fd, max_bytes=1024 * 1024) != index["manifest_ciphertext_sha256"]:
            _fail("manifest_ciphertext_digest_mismatch")
        temporary_manifest = RECOVERY_MOUNT / f"manifest-{secrets.token_hex(8)}.json"
        try:
            _decrypt_fd(manifest_fd, temporary_manifest)
            manifest = _validate_manifest(
                json.loads(temporary_manifest.read_text(encoding="utf-8")),
                index=index,
                kind="wal",
            )
            if _source_fingerprint(manifest_before) != _source_fingerprint(os.fstat(manifest_fd)):
                _fail("source_changed_during_read")
        except (UnicodeError, json.JSONDecodeError) as exc:
            raise BackupError("manifest_invalid") from exc
        finally:
            with suppress(OSError):
                temporary_manifest.unlink()
        if (
            manifest.get("object_id") != wal_name
            or _sha256_fd(encrypted_fd, max_bytes=2 * 1024**3) != manifest["ciphertext_sha256"]
        ):
            _fail("wal_object_invalid")
        encrypted_before = os.fstat(encrypted_fd)
    except BaseException:
        for descriptor in member_fds:
            os.close(descriptor)
        os.close(object_fd)
        raise
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = destination.with_name(f".{destination.name}.{secrets.token_hex(8)}.tmp")
    try:
        _decrypt_fd(encrypted_fd, temporary)
        if (
            _source_fingerprint(encrypted_before) != _source_fingerprint(os.fstat(encrypted_fd))
            or _sha256_fd(encrypted_fd, max_bytes=2 * 1024**3) != manifest["ciphertext_sha256"]
        ):
            _fail("source_changed_during_read")
        if _sha256(temporary) != manifest["plaintext_sha256"]:
            _fail("plaintext_digest_mismatch")
        if destination.exists():
            _fail("wal_restore_destination_exists")
        os.rename(temporary, destination)
        _fsync_dir(destination.parent)
    finally:
        for descriptor in member_fds:
            os.close(descriptor)
        os.close(object_fd)
        with suppress(OSError):
            temporary.unlink()


def verify_backup(backup_id: str) -> None:
    if backup_id == "latest":
        latest = _read_manifest_like_status(STATUS_ROOT / "latest-base.json")
        backup_id = latest
    _require_exact_mount(BACKUP_MOUNT, writable=False)
    destination = RECOVERY_MOUNT / f"verify-{backup_id}"
    if destination.exists():
        _fail("verification_destination_exists")
    _require_recovery_destination(destination)
    encrypted, manifest = _base_object(backup_id)
    tar_path = RECOVERY_MOUNT / f".{backup_id}.{secrets.token_hex(8)}.tar"
    try:
        _decrypt_file(encrypted, tar_path)
        if _sha256(tar_path) != manifest["plaintext_sha256"]:
            _fail("plaintext_digest_mismatch")
        _safe_extract(tar_path, destination)
        _require_executable(PG_BINDIR / "pg_verifybackup")
        _run([str(PG_BINDIR / "pg_verifybackup"), "--no-parse-wal", str(destination)])
    finally:
        shutil.rmtree(destination, ignore_errors=True)
        with suppress(OSError):
            tar_path.unlink()
    _replace_json(
        STATUS_ROOT / "latest-verification.json", {"object_id": backup_id, "result": "ok"}
    )
    index = _read_index(BASE_ROOT / backup_id / "index.json", kind="base_backup")
    _replace_json(
        VERIFICATION_ROOT / f"{backup_id}.json",
        {
            "manifest_ciphertext_sha256": index["manifest_ciphertext_sha256"],
            "object_id": backup_id,
            "result": "isolated_pg_verifybackup_ok",
            "verified_at": dt.datetime.now(dt.UTC).isoformat(),
        },
    )
    _log("backup_verify", "ok", backup_id.lower())


def _read_manifest_like_status(path: Path) -> str:
    _require_regular_file(path, max_bytes=4096, mode=STORE_FILE_MODE)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        object_id = value["object_id"]
    except (OSError, UnicodeError, json.JSONDecodeError, KeyError, TypeError) as exc:
        raise BackupError("status_invalid") from exc
    if not isinstance(object_id, str) or not BACKUP_ID_RE.fullmatch(object_id):
        _fail("status_invalid")
    return object_id


def _verified_bases() -> list[tuple[dt.datetime, Path, dict[str, Any]]]:
    result = []
    for entry in BASE_ROOT.iterdir():
        if not BACKUP_ID_RE.fullmatch(entry.name) or entry.is_symlink() or not entry.is_dir():
            _fail("unexpected_backup_object")
        manifest = _read_index(entry / "index.json", kind="base_backup")
        if (
            manifest.get("object_id") != entry.name
            or manifest.get("verification") != "source_pg_verifybackup_ok"
        ):
            continue
        marker_path = VERIFICATION_ROOT / f"{entry.name}.json"
        if not marker_path.exists():
            continue
        _require_regular_file(marker_path, max_bytes=4096, mode=STORE_FILE_MODE)
        try:
            marker = json.loads(marker_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise BackupError("verification_marker_invalid") from exc
        if set(marker) != {
            "manifest_ciphertext_sha256",
            "object_id",
            "result",
            "verified_at",
        } or (
            marker.get("object_id") != entry.name
            or marker.get("manifest_ciphertext_sha256") != manifest["manifest_ciphertext_sha256"]
            or marker.get("result") != "isolated_pg_verifybackup_ok"
        ):
            _fail("verification_marker_invalid")
        encrypted_manifest = entry / "recovery-manifest.json.age"
        _require_regular_file(encrypted_manifest, max_bytes=1024 * 1024, mode=STORE_FILE_MODE)
        if _sha256(encrypted_manifest) != manifest["manifest_ciphertext_sha256"]:
            _fail("manifest_ciphertext_digest_mismatch")
        try:
            created = dt.datetime.fromisoformat(manifest["created_at"])
        except (TypeError, ValueError) as exc:
            raise BackupError("manifest_invalid") from exc
        result.append((created, entry, manifest))
    return sorted(result, reverse=True, key=lambda item: item[0])


def _read_inventory_json(path: Path, *, max_bytes: int = 64 * 1024) -> object:
    _require_regular_file(path, max_bytes=max_bytes, mode=STORE_FILE_MODE)
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise BackupError("inventory_artifact_invalid") from exc


def _retention_timestamp(value: object, *, code: str) -> dt.datetime:
    if not isinstance(value, str):
        _fail(code)
    try:
        parsed = dt.datetime.fromisoformat(value)
    except ValueError as exc:
        raise BackupError(code) from exc
    if parsed.utcoffset() != dt.timedelta(0):
        _fail(code)
    return parsed


def _retention_inventory() -> tuple[dict[str, dict[str, object]], dict[str, int]]:
    category_names = (
        "base_objects",
        "wal_history_objects",
        "restore_points",
        "holds",
        "verification_markers",
        "indexes_manifests",
        "status_artifacts",
    )
    records: dict[str, list[dict[str, object]]] = {name: [] for name in category_names}
    seen_paths: set[Path] = set()
    apparent_bytes = 0
    allocated_bytes = 0

    def account(path: Path) -> os.stat_result:
        nonlocal apparent_bytes, allocated_bytes
        try:
            info = path.lstat()
        except OSError as exc:
            raise BackupError("inventory_artifact_invalid") from exc
        if path.is_symlink():
            _fail("inventory_artifact_invalid")
        if path not in seen_paths:
            seen_paths.add(path)
            if len(seen_paths) > 200_000:
                _fail("inventory_limit_exceeded")
            apparent_bytes += info.st_size
            allocated_bytes += info.st_blocks * 512
        return info

    def add(
        category: str,
        path: Path,
        *,
        artifact_type: str,
        content_sha256: str | None = None,
        binding_sha256: str | None = None,
    ) -> None:
        info = account(path)
        record: dict[str, object] = {
            "mode": f"{stat.S_IMODE(info.st_mode):04o}",
            "path": path.relative_to(STORE).as_posix(),
            "size_bytes": info.st_size,
            "type": artifact_type,
        }
        if content_sha256 is not None:
            record["content_sha256"] = content_sha256
        if binding_sha256 is not None:
            record["binding_sha256"] = binding_sha256
        records[category].append(record)

    expected_roots = {
        BASE_ROOT,
        WAL_ROOT,
        STATUS_ROOT,
        VERIFICATION_ROOT,
        STAGING_ROOT,
    }
    for path in expected_roots | {STORE}:
        info = account(path)
        if not stat.S_ISDIR(info.st_mode):
            _fail("inventory_artifact_invalid")
    try:
        store_entries = set(STORE.iterdir())
    except OSError as exc:
        raise BackupError("inventory_artifact_invalid") from exc
    if store_entries != expected_roots:
        _fail("unexpected_store_object")
    if any(STAGING_ROOT.iterdir()):
        _fail("staging_residue_present")

    base_indexes: dict[str, dict[str, Any]] = {}
    for root in BASE_ROOT.iterdir():
        if not BACKUP_ID_RE.fullmatch(root.name) or root.is_symlink() or not root.is_dir():
            _fail("unexpected_backup_object")
        _require_directory(root, mode=STORE_DIRECTORY_MODE)
        account(root)
        members = {path.name: path for path in root.iterdir()}
        required = {"backup.tar.age", "index.json", "recovery-manifest.json.age"}
        optional = {"DEPENDENCIES.json", "HOLD", "PITR-VERIFIED.json", "RESTORE-POINTS.json"}
        if not required.issubset(members) or not set(members).issubset(required | optional):
            _fail("unexpected_backup_member")
        index = _read_index(members["index.json"], kind="base_backup")
        if index.get("object_id") != root.name:
            _fail("manifest_invalid")
        if index.get("verification") != "source_pg_verifybackup_ok":
            _fail("manifest_invalid")
        _retention_timestamp(index.get("created_at"), code="manifest_invalid")
        base_indexes[root.name] = index
        _require_regular_file(
            members["backup.tar.age"], max_bytes=16 * 1024**4, mode=STORE_FILE_MODE
        )
        _require_regular_file(
            members["recovery-manifest.json.age"],
            max_bytes=1024 * 1024,
            mode=STORE_FILE_MODE,
        )
        if _sha256(members["recovery-manifest.json.age"]) != index["manifest_ciphertext_sha256"]:
            _fail("manifest_ciphertext_digest_mismatch")
        add(
            "base_objects",
            root,
            artifact_type="directory",
            content_sha256=_sha256(members["backup.tar.age"]),
            binding_sha256=index["manifest_ciphertext_sha256"],
        )
        for name in ("index.json", "recovery-manifest.json.age"):
            add(
                "indexes_manifests",
                members[name],
                artifact_type="regular_file",
                content_sha256=_sha256(members[name]),
            )
        account(members["backup.tar.age"])
        if "HOLD" in members:
            _require_regular_file(members["HOLD"], max_bytes=4096, mode=STORE_FILE_MODE)
            _read_small_text(members["HOLD"], code="hold_invalid", max_bytes=4096)
            add(
                "holds",
                members["HOLD"],
                artifact_type="regular_file",
                content_sha256=_sha256(members["HOLD"]),
            )
        for name, category in (
            ("PITR-VERIFIED.json", "verification_markers"),
            ("RESTORE-POINTS.json", "restore_points"),
            ("DEPENDENCIES.json", "indexes_manifests"),
        ):
            if name in members:
                _read_inventory_json(members[name])
                add(
                    category,
                    members[name],
                    artifact_type="regular_file",
                    content_sha256=_sha256(members[name]),
                )

    for root in WAL_ROOT.iterdir():
        if not WAL_RE.fullmatch(root.name) or root.is_symlink() or not root.is_dir():
            _fail("unexpected_wal_object")
        _require_directory(root, mode=STORE_DIRECTORY_MODE)
        account(root)
        members = {path.name: path for path in root.iterdir()}
        required = {"index.json", "recovery-manifest.json.age", "segment.age"}
        if set(members) not in (required, required | {"HOLD"}):
            _fail("unexpected_wal_member")
        index = _read_index(members["index.json"], kind="wal")
        if index.get("object_id") != root.name:
            _fail("manifest_invalid")
        _retention_timestamp(index.get("created_at"), code="manifest_invalid")
        _require_regular_file(members["segment.age"], max_bytes=2 * 1024**3, mode=STORE_FILE_MODE)
        _require_regular_file(
            members["recovery-manifest.json.age"],
            max_bytes=1024 * 1024,
            mode=STORE_FILE_MODE,
        )
        if _sha256(members["segment.age"]) != index["ciphertext_sha256"]:
            _fail("ciphertext_digest_mismatch")
        if _sha256(members["recovery-manifest.json.age"]) != index["manifest_ciphertext_sha256"]:
            _fail("manifest_ciphertext_digest_mismatch")
        add(
            "wal_history_objects",
            root,
            artifact_type="directory",
            binding_sha256=index["ciphertext_sha256"],
        )
        for name in ("index.json", "recovery-manifest.json.age"):
            add(
                "indexes_manifests",
                members[name],
                artifact_type="regular_file",
                content_sha256=_sha256(members[name]),
            )
        account(members["segment.age"])
        if "HOLD" in members:
            _require_regular_file(members["HOLD"], max_bytes=4096, mode=STORE_FILE_MODE)
            _read_small_text(members["HOLD"], code="hold_invalid", max_bytes=4096)
            add(
                "holds",
                members["HOLD"],
                artifact_type="regular_file",
                content_sha256=_sha256(members["HOLD"]),
            )

    for marker_path in VERIFICATION_ROOT.iterdir():
        match = re.fullmatch(r"([0-9]{8}T[0-9]{6}Z-[0-9a-f]{16})\.json", marker_path.name)
        if match is None:
            _fail("verification_marker_invalid")
        object_id = match.group(1)
        if object_id not in base_indexes:
            _fail("verification_marker_invalid")
        _require_regular_file(marker_path, max_bytes=4096, mode=STORE_FILE_MODE)
        marker = _read_inventory_json(marker_path, max_bytes=4096)
        index = base_indexes[object_id]
        if (
            not isinstance(marker, dict)
            or set(marker)
            != {
                "manifest_ciphertext_sha256",
                "object_id",
                "result",
                "verified_at",
            }
            or (
                marker.get("object_id") != object_id
                or marker.get("manifest_ciphertext_sha256") != index["manifest_ciphertext_sha256"]
                or marker.get("result") != "isolated_pg_verifybackup_ok"
            )
        ):
            _fail("verification_marker_invalid")
        _retention_timestamp(marker.get("verified_at"), code="verification_marker_invalid")
        add(
            "verification_markers",
            marker_path,
            artifact_type="regular_file",
            content_sha256=_sha256(marker_path),
        )

    for status_path in STATUS_ROOT.iterdir():
        if not re.fullmatch(r"latest-(?:base|wal|verification|retention)\.json", status_path.name):
            _fail("status_invalid")
        if not isinstance(_read_inventory_json(status_path, max_bytes=4096), dict):
            _fail("status_invalid")
        account(status_path)
        if status_path.name != "latest-retention.json":
            add(
                "status_artifacts",
                status_path,
                artifact_type="regular_file",
                content_sha256=_sha256(status_path),
            )

    for path in seen_paths:
        info = path.lstat()
        if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            _fail("inventory_artifact_invalid")

    summaries: dict[str, dict[str, object]] = {}
    for category in category_names:
        canonical = json.dumps(
            sorted(records[category], key=lambda value: str(value["path"])),
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
        summaries[category] = {
            "count": len(records[category]),
            "sha256": hashlib.sha256(canonical).hexdigest(),
        }
    return summaries, {
        "store_allocated_bytes": allocated_bytes,
        "store_apparent_bytes": apparent_bytes,
    }


def retain() -> None:
    _ensure_store(staging_writable=False)
    inventory, store_capacity = _retention_inventory()
    bases = _verified_bases()
    if not bases:
        _fail("no_verified_recovery_chain")
    # A decrypt-plus-pg_verifybackup marker is necessary but not sufficient to
    # prove a recoverable chain. Until a separately authenticated PITR result
    # and exact base/WAL/timeline/restore-point dependency catalog exist, every
    # deletion target is ambiguous and retention is a validation-only no-op.
    capacity = shutil.disk_usage(BACKUP_MOUNT)
    if capacity.total <= 0 or capacity.free * 10 < capacity.total:
        _fail("capacity_below_no_prune_floor")
    _replace_json(
        STATUS_ROOT / "latest-retention.json",
        {
            "capacity": {
                "filesystem_available_bytes": capacity.free,
                "filesystem_total_bytes": capacity.total,
                "filesystem_used_bytes": capacity.used,
                **store_capacity,
            },
            "inventory": inventory,
            "kept_base_count": len(bases),
            "newest_verified_id": bases[0][1].name,
            "result": "no_prune_dependency_watermark_absent",
        },
    )
    _log("retention", "no_prune_dependency_watermark_absent", bases[0][1].name.lower())


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)
    wal = commands.add_parser("archive-wal", allow_abbrev=False)
    wal.add_argument("source")
    wal.add_argument("wal_name")
    commands.add_parser("base-backup", allow_abbrev=False)
    verify = commands.add_parser("verify", allow_abbrev=False)
    verify.add_argument("backup_id")
    commands.add_parser("retain", allow_abbrev=False)
    restore = commands.add_parser("prepare-restore", allow_abbrev=False)
    restore.add_argument("backup_id")
    restore.add_argument("destination")
    targets = restore.add_mutually_exclusive_group(required=True)
    targets.add_argument("--target-name")
    targets.add_argument("--target-time")
    targets.add_argument("--target-lsn")
    restore_wal_parser = commands.add_parser("restore-wal", allow_abbrev=False)
    restore_wal_parser.add_argument("wal_name")
    restore_wal_parser.add_argument("destination")
    return parser


def main() -> int:
    arguments = _parser().parse_args()
    try:
        if arguments.command == "archive-wal":
            archive_wal(arguments.source, arguments.wal_name)
        elif arguments.command == "base-backup":
            base_backup()
        elif arguments.command == "verify":
            verify_backup(arguments.backup_id)
        elif arguments.command == "retain":
            retain()
        elif arguments.command == "prepare-restore":
            values = {
                "name": arguments.target_name,
                "time": arguments.target_time,
                "lsn": arguments.target_lsn,
            }
            kind, target = next(
                (kind, value) for kind, value in values.items() if value is not None
            )
            prepare_restore(arguments.backup_id, arguments.destination, kind, target)
        elif arguments.command == "restore-wal":
            restore_wal(arguments.wal_name, arguments.destination)
        return 0
    except BackupError as exc:
        _log(arguments.command.replace("-", "_"), str(exc))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
