{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.scalevault.dev/sealed-content-envelope-v1.schema.json",
    "title": "ScaleVault sealed content envelope v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contract_version",
        "envelope_version",
        "algorithm",
        "content_key_id",
        "nonce",
        "ciphertext",
        "aad_sha256",
        "safe_summary"
    ],
    "properties": {
        "contract_version": { "const": "scalevault.sealed-content-envelope.v1" },
        "envelope_version": { "const": 1 },
        "algorithm": { "const": "AES-256-GCM" },
        "content_key_id": { "$ref": "#/$defs/uuidv7" },
        "nonce": {
            "type": "string",
            "contentEncoding": "base64",
            "pattern": "^[A-Za-z0-9+/]{16}$"
        },
        "ciphertext": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 24,
            "maxLength": 955756,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "aad_sha256": { "$ref": "#/$defs/sha256" },
        "safe_summary": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "$defs": {
        "uuidv7": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
}
